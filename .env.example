# wallet-backend environment template. Copy to .env and edit.
# Every value is also a CLI flag: FOO_BAR <-> --foo-bar. See docs/configuration.md.

# ---- Shared by serve and ingest ----
DATABASE_URL=postgres://postgres@localhost:5432/wallet-backend?sslmode=disable
RPC_URL=http://localhost:8000
# Testnet: "Test SDF Network ; September 2015"   Pubnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
LOG_LEVEL=INFO
# Sentry. Leave TRACKER_DSN empty to disable error reporting.
TRACKER_DSN=
STELLAR_ENVIRONMENT=
# pprof on /debug/pprof. 0 disables the listener.
ADMIN_PORT=0
# pgx pool tuning.
DB_MAX_CONNS=10
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=5m
DB_MAX_CONN_IDLE_TIME=10s

# ---- serve ----
PORT=8001
# Comma-separated Stellar public keys allowed to sign requests. Empty disables auth.
CLIENT_AUTH_PUBLIC_KEYS=
CLIENT_AUTH_MAX_TIMEOUT_SECONDS=15
CLIENT_AUTH_MAX_BODY_SIZE_BYTES=102400
GRAPHQL_COMPLEXITY_LIMIT=10000
GRAPHQL_INTROSPECTION_ENABLED=false

# ---- ingest ----
# live (default) follows the chain tip; backfill fills [START_LEDGER, END_LEDGER].
INGESTION_MODE=live
START_LEDGER=
END_LEDGER=
INGEST_SERVER_PORT=8002
# rpc (default) reads ledgers from RPC_URL; datastore reads them from an S3 data lake.
LEDGER_BACKEND_TYPE=rpc
GET_LEDGERS_LIMIT=10
# History archive used to bootstrap balances on first start. Pubnet: https://history.stellar.org/prd/core-live/core_live_001/
ARCHIVE_URL=https://history.stellar.org/prd/core-testnet/core_testnet_001/
CHECKPOINT_FREQUENCY=64
# Datastore backend only.
DATASTORE_BUCKET_PATH=
DATASTORE_REGION=us-east-2
DATASTORE_ENDPOINT_URL=
DATASTORE_BUFFER_SIZE=100
DATASTORE_NUM_WORKERS=10
DATASTORE_RETRY_LIMIT=3
DATASTORE_RETRY_WAIT=5s
DATASTORE_LEDGERS_PER_FILE=0
DATASTORE_FILES_PER_PARTITION=0
# Backfill tuning. BACKFILL_WORKERS=0 uses one worker per CPU.
BACKFILL_WORKERS=0
BACKFILL_BATCH_SIZE=250
BACKFILL_DB_INSERT_BATCH_SIZE=100
# TimescaleDB policies, applied by the live ingester. Empty keeps the database's current setting.
CHUNK_INTERVAL=1 day
RETENTION_PERIOD=
COMPRESSION_SCHEDULE_INTERVAL=
COMPRESSION_COMPRESS_AFTER=
COMPRESSION_MAX_CHUNKS=0
